{
  "name": "network",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -p none \"serwist build --watch\" \"next dev -p 3100\"",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint .",
    "lint:design": "tsx scripts/check-design.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed-cities": "tsx scripts/seed-cities.ts",
    "notes:export": "tsx scripts/apple-notes/export.ts",
    "dev:cloud": "dotenv run -f .env.cloud.local --override -q -- concurrently -p none \"serwist build --watch\" \"next dev -p 3100\"",
    "notes:import": "dotenv run -f .env.cloud.local --override -q -- tsx scripts/import-cli.ts .cache/notes-export.clean.json --label \"Apple Notes\"",
    "notes:clean": "python3 scripts/apple-notes/clean.py",
    "notes:resume": "dotenv run -f .env.cloud.local --override -q -- tsx scripts/import-cli.ts --resume",
    "import:backup": "tsx scripts/import/backup.ts",
    "import:diff": "tsx scripts/import/diff.ts",
    "import:ingest": "tsx scripts/import/ingest.ts",
    "import:screen": "tsx scripts/import/run-stage.ts --stage screen",
    "import:extract": "tsx scripts/import/run-stage.ts --stage extract",
    "import:prepare": "tsx scripts/import/prepare.ts",
    "import:validate": "tsx scripts/import/validate.ts",
    "import:apply": "tsx scripts/import/apply.ts",
    "import:reconcile": "tsx scripts/import/reconcile.ts",
    "import:file": "tsx scripts/import/file-notes.ts",
    "import:review": "tsx scripts/import/review.ts",
    "import:commit": "tsx scripts/import/commit.ts",
    "import:verify": "tsx scripts/import/verify.ts",
    "import:spotcheck": "tsx scripts/import/spotcheck.ts",
    "import:rollback": "tsx scripts/import/rollback.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.56",
    "@ai-sdk/react": "^4.0.108",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@serwist/next": "^9.5.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ai": "^7.0.105",
    "ai-sdk-provider-claude-code": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.14.0",
    "mcp-handler": "^2.3.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "nodemailer": "^10.1.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
