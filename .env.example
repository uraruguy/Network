# The Network: environment variables.
#
# Local development: run `supabase start`, then `pnpm bootstrap`. It writes .env.local for you
# (Supabase URL and keys, generated secrets) and never overwrites a value that is already set.
# Production (Vercel): set the same names under Project Settings → Environment Variables.
#
# Every name the code reads is listed here. Optional ones are commented out on purpose: an empty
# value (`NAME=`) is not the same as unset and fails validation in src/lib/env.ts.
# Never commit real values: .env* files are gitignored except this one.

# ─── Required ────────────────────────────────────────────────────────────────────────────────

# Supabase API URL. Local: http://127.0.0.1:54321. Cloud: Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon (public) key. Local: `supabase status` (ANON_KEY). Cloud: Project Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string. The app talks to Postgres directly (Drizzle), not through the Data API.
# Cloud: Connect → Transaction pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Public URL of the app (https in production). It is the passkey relying-party ID (moving to another
# domain orphans enrolled passkeys), the MCP OAuth resource and the base of e-mail links.
# Inlined at build time: redeploy after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3100
# Root key for everything the app signs or encrypts itself (passkey cookie, WebAuthn challenges,
# recovery codes, e-mail action links, stored API keys). At least 32 characters. The app refuses to
# start in production without it. Generate: openssl rand -base64 48
APP_SECRET=

# ─── Auth & security ─────────────────────────────────────────────────────────────────────────

# The previous APP_SECRET while rotating: still accepted for verification, never used to sign.
# APP_SECRET_PREVIOUS=
# Passkey second factor. Unset = required (the production default). "false" for local development only.
# AUTH_REQUIRE_PASSKEY=false

# ─── AI (optional: Settings → AI & e-mail can hold the provider and key instead) ─────────────
# Values here win over Settings, which then shows them as "Managed by environment".

# agent-sdk = your Claude subscription through the local Claude Code CLI (Mac only, not serverless),
# anthropic or openrouter. Unset = pick whichever key is present.
# AI_PROVIDER=anthropic
# Anthropic API key (console.anthropic.com).
# ANTHROPIC_API_KEY=sk-ant-...
# OpenRouter API key (openrouter.ai).
# OPENROUTER_API_KEY=sk-or-...
# OpenRouter main model when AI_MODEL_MAIN is unset.
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Model overrides in the provider's own naming (claude-sonnet-5-5 · anthropic/claude-sonnet-5.5 · sonnet).
# AI_MODEL_MAIN=claude-sonnet-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# Chat-only overrides, so the assistant can use a different model than the import pipeline.
# AI_CHAT_MODEL=claude-sonnet-5-5
# AI_CHAT_MODEL_FAST=claude-haiku-5-5

# ─── E-mail (optional: Settings → AI & e-mail can hold it instead) ───────────────────────────

# Resend API key (resend.com).
# RESEND_API_KEY=re_...
# SMTP instead of Resend; wins over RESEND_API_KEY.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender for the digest and security alerts. Default: The Network <onboarding@resend.dev>
# EMAIL_FROM="The Network <network@example.com>"

# ─── Cron & inbox (pnpm bootstrap generates both) ────────────────────────────────────────────

# Bearer token for /api/cron/reminders (Vercel Cron and Supabase pg_cron). At least 16 characters.
# Without it the daily digest never runs. Generate: openssl rand -hex 24
# CRON_SECRET=
# Bearer token for /api/inbox (the "Send to The Network" iPhone Shortcut). At least 16 characters.
# Without it the endpoint is off. Generate: openssl rand -hex 24
# INBOX_TOKEN=

# ─── Dev & scripts (never needed on Vercel) ──────────────────────────────────────────────────

# Supabase service-role key. Only local scripts use it (pnpm bootstrap, scripts/seed-dev-user.ts),
# and both refuse non-local URLs. The app never reads it: don't set it on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
# Owner account for scripts/seed-dev-user.ts (defaults: dev@local.test / network-dev-2026) and the
# local seed scripts in scripts/dev.
# DEV_EMAIL=dev@local.test
# DEV_PASSWORD=
# Opt-in database tests against a LOCAL Supabase (test/db.integration.test.ts).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Parallel extractions in the legacy one-shot importer (scripts/import-cli.ts). Default 6.
# IMPORT_CONCURRENCY=6
# Any value: import scripts print full stack traces on failure.
# DEBUG=1
#
# Set by the platform, not by you: NODE_ENV, NEXT_PHASE, VERCEL.
